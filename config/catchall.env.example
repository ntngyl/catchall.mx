# CatchAll.mx Environment Configuration
# Copy this file to /etc/catchall.env and fill in your values

# SMTP Configuration (for sending verification emails)
# Use a transactional email service like Mailgun, SendGrid, Postmark, etc.
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USERNAME=your-email@domain.com
SMTP_PASSWORD=your-smtp-password

# From address for verification emails
FROM_EMAIL=verify@yourdomain.com
FROM_NAME=YourDomain

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# Your server's domain name
DOMAIN=yourdomain.com
