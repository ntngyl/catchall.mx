# Output of postconf -n on the live server, minus host name and certificate paths.
catchall-pipe_destination_recipient_limit = 1
inet_interfaces = all
inet_protocols = ipv4
maillog_file = /var/log/mail.log
message_size_limit = 20971520
milter_default_action = accept
milter_mail_macros = i {mail_addr} {client_addr} {client_name} {auth_authen}
milter_protocol = 6
mydestination =
postscreen_access_list = permit_mynetworks
postscreen_bare_newline_action = enforce
postscreen_bare_newline_enable = no
postscreen_dnsbl_action = enforce
postscreen_dnsbl_sites = bl.spamcop.net*2 psbl.surriel.com*2 bl.mailspike.net*2 dnsbl.dronebl.org*1 zen.spamhaus.org=127.0.0.[2..11]*0
postscreen_dnsbl_threshold = 3
postscreen_greet_action = enforce
postscreen_non_smtp_command_action = enforce
postscreen_non_smtp_command_enable = no
postscreen_pipelining_action = enforce
postscreen_pipelining_enable = no
recipient_canonical_classes = envelope_recipient, header_recipient
recipient_canonical_maps = tcp:localhost:10002
relay_domains =
sender_canonical_classes = envelope_sender
sender_canonical_maps = tcp:localhost:10001
smtp_tls_security_level = may
smtpd_helo_required = yes
smtpd_helo_restrictions = permit_mynetworks, reject_invalid_helo_hostname
smtpd_milters = inet:127.0.0.1:11332
smtpd_recipient_restrictions = permit_mynetworks, check_policy_service inet:127.0.0.1:10032
smtpd_relay_restrictions = permit_mynetworks, reject_unauth_destination
smtpd_sender_restrictions = permit_mynetworks, reject_non_fqdn_sender
smtpd_tls_security_level = may
smtpd_use_tls = yes
virtual_mailbox_domains = regexp:/etc/postfix/virtual_domains
virtual_mailbox_maps = regexp:/etc/postfix/virtual_mailbox
virtual_transport = catchall-pipe
